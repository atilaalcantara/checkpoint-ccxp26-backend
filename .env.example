# Copy these settings into the server's existing /home/ubuntu/apps/checkpoint/.env.
# Replace the domain and set a one-time random bootstrap secret on the server only.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Checkpoint=Host=postgres-host;Port=5432;Database=checkpoint;Username=checkpoint_app;Password=REPLACE_ON_SERVER
Cors__Origins__0=https://checkpoint.example.com
Fido2__ServerDomain=checkpoint.example.com
Fido2__Origins__0=https://checkpoint.example.com
Proxy__TrustForwardedHeaders=true
DataProtection__KeyRingPath=/var/lib/checkpoint-data-protection
AdminAuth__BootstrapSecret=
AdminAuth__BootstrapExpiresUtc=
